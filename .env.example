# Application
# Port the API is exposed on the host
APP_PORT=8000
# Secret used to sign JWT access tokens. CHANGE THIS IN PRODUCTION.
TASK_API_SECRET_KEY=dev-secret-change-me

# Database
# SQLAlchemy URL used by the app and by Alembic migrations.
# When running via docker compose, this defaults to the postgres service.
DATABASE_URL=postgresql+psycopg2://task_api:task_api@postgres:5432/task_api
POSTGRES_USER=task_api
POSTGRES_PASSWORD=task_api
POSTGRES_DB=task_api
POSTGRES_PORT=5432

# Redis cache
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379
# Set to true/1 to enable the optional Redis-backed task cache
CACHE_ENABLED=true
